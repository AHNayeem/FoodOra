# =============================================================================
# FoodOra backend — environment contract (Phase D10)
#
# Every key is validated by a Zod schema at boot (config/validation.schema.ts).
# A missing or malformed REQUIRED key fails the process; it never fails the
# first request that happens to need it.
#
# Secrets are resolved from AWS Secrets Manager / Vault in staging and
# production. This file documents the SHAPE, and is the local-dev template.
# =============================================================================

# --- app ---------------------------------------------------------------------
NODE_ENV=development                       # development | test | production
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3005              # the Next.js frontend
CORS_ORIGINS=http://localhost:3005
LOG_LEVEL=debug                            # trace|debug|info|warn|error
# Fallbacks only. Since E3 these are what a request resolves to when the `countries`
# table has no row for it, or cannot be reached — the country row is the real source of
# a new account's currency, locale and timezone. Run `bun run seed:reference` to populate it.
DEFAULT_COUNTRY=BD
DEFAULT_CURRENCY=BDT
DEFAULT_LOCALE=en

# --- database (REQUIRED) -----------------------------------------------------
DATABASE_URL=postgresql://foodora:foodora@localhost:5432/foodora?schema=public&connection_limit=10
# Bypasses PgBouncer — migrations need session-level state.
DATABASE_DIRECT_URL=postgresql://foodora:foodora@localhost:5432/foodora?schema=public
# Optional read replica; reads are routed here only via an explicit marker.
DATABASE_REPLICA_URL=

# --- redis (REQUIRED) --------------------------------------------------------
# Three logical DBs so a cache flush cannot drop the job queue.
REDIS_URL=redis://localhost:6379/0         # cache      (allkeys-lru)
REDIS_QUEUE_URL=redis://localhost:6379/1   # BullMQ     (noeviction)
REDIS_PUBSUB_URL=redis://localhost:6379/2  # pub/sub

# --- auth (REQUIRED) ---------------------------------------------------------
# RS256. Generate: openssl genrsa -out jwt.pem 2048 && openssl rsa -in jwt.pem -pubout
# Left blank outside production, where an ephemeral pair is generated at boot and
# every token dies on restart. Production refuses to start without them.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=k1
# Set both while rotating: JWKS publishes the pair and tokens signed with the old
# kid still verify, so a rotation is a deploy rather than a forced sign-out.
JWT_PREVIOUS_PUBLIC_KEY=
JWT_PREVIOUS_KEY_ID=
JWT_ISSUER=foodora
JWT_AUDIENCE=foodora-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_TTL_SHORT=7d                 # without "remember me"
PASSWORD_RESET_TTL=30m
# How long a completed rotation stays replayable, so two tabs refreshing at once
# do not read as token theft. 0 disables it and makes that race a forced sign-out.
REFRESH_REPLAY_WINDOW_MS=10000
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=                                # REQUIRED — server-side pepper for OTP hashes
OTP_LOG_CODES=true                         # dev only — prints codes and reset links; refused in production
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
COOKIE_DOMAIN=localhost
AUTH_COOKIE_PATH=/auth                     # so the refresh cookie never reaches /graphql

# --- social login ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- object storage (REQUIRED) -----------------------------------------------
S3_ENDPOINT=http://localhost:9000          # MinIO locally
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=foodora-public
S3_BUCKET_PRIVATE=foodora-private
S3_FORCE_PATH_STYLE=true                   # required by MinIO
CDN_BASE_URL=http://localhost:9000/foodora-public
UPLOAD_MAX_BYTES=10485760                  # 10 MB
UPLOAD_URL_TTL=300                         # presigned POST expiry, seconds

# --- payments ----------------------------------------------------------------
# Provider ENABLEMENT lives in the `payment_providers` table, not here.
# These are the secret VALUES referenced by PaymentProvider.credentialRefs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
ROCKET_MERCHANT_ID=
ROCKET_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- notifications -----------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025                             # Mailpit locally
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FoodOra <no-reply@foodora.app>"
SMS_PROVIDER=log                           # log | twilio | <local gateway>
SMS_API_KEY=
SMS_SENDER_ID=FOODORA

# --- maps / geo --------------------------------------------------------------
# Showing a map: tiles, geocoding, a marker on the tracking screen.
MAPS_PROVIDER=none                         # none | google | mapbox
MAPS_API_KEY=

# --- routing (V1 Unit 2) -----------------------------------------------------
# Measuring a path, which is billed per element and routinely bought from a
# different vendor than the map. Only `haversine` is implemented; selecting any
# other name ABORTS THE BOOT rather than quietly returning great-circle distance —
# a fare built on a straight line is wrong by a factor of three in a river delta.
ROUTING_PROVIDER=haversine                 # haversine | google | osrm | mapbox | openrouteservice
ROUTING_API_KEY=
ROUTING_BASE_URL=                          # OSRM is normally self-hosted, so no default host
ROUTING_TIMEOUT_MS=2000

# --- catalog listing (V1) ----------------------------------------------------
# `openNow` and two of the four sorts cannot be expressed in SQL, so the repository
# narrows what it can and hands the application layer a capped candidate set. Above
# the cap, `total` is a floor and late pages may be short — the service logs when a
# query reaches it. The right number is a property of the catalogue's size.
CATALOG_CANDIDATE_LIMIT=500
CATALOG_RAIL_LIMIT=50                      # ceiling on trendingVendors(limit:) and friends
# Cache lifetimes. 0 means DO NOT CACHE (honoured on read too), which is how a
# suspected staleness bug gets bisected in production without a deploy.
CATALOG_RAILS_TTL_SECONDS=900              # cuisines + categories: editorial, changed before a campaign
CATALOG_MENU_TTL_SECONDS=300               # menus + dishes: edited by a merchant during service

# --- cart (V1 Unit 2) --------------------------------------------------------
# Not anti-abuse limits — statements about what a food-delivery basket is. Fifty
# configurations and twenty units of each is already an implausible dinner; beyond
# it the customer wants the catering flow.
CART_MAX_LINES=50
CART_MAX_LINE_QUANTITY=20
CART_TTL_HOURS=72                          # stamps expiresAt; nothing sweeps it yet

# --- ai ----------------------------------------------------------------------
# The Phase C assistant is deterministic and local; a provider is optional.
AI_PROVIDER=local                          # local | <adapter name>
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_BUDGET_USD=0

# --- graphql / limits --------------------------------------------------------
GRAPHQL_PLAYGROUND=true                    # MUST be false in production
GRAPHQL_INTROSPECTION=true                 # MUST be false in production
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_COMPLEXITY=1000
# May this process overwrite the committed schema.gql? Only `schema:emit` and
# `schema:check` set it. Off by default so that starting the server — in particular
# `start:dev`, which recompiles on every keystroke — cannot rewrite a reviewed artifact.
GRAPHQL_SCHEMA_EMIT=false
RATE_LIMIT_AUTHENTICATED=300               # per minute
RATE_LIMIT_ANONYMOUS=60

# --- catalog / cart / checkout (V1) ------------------------------------------
# Limits that used to be constants in domain code. The defaults ARE those constants,
# so an empty environment behaves exactly as the code did before they moved.
CATALOG_CANDIDATE_LIMIT=500                # rows a filtered listing may consider
CATALOG_RAIL_LIMIT=50                      # ceiling on a bare-Int rail limit
CATALOG_RAILS_TTL_SECONDS=900              # 0 = do not cache (a kill switch, not "forever")
CATALOG_MENU_TTL_SECONDS=300
CART_MAX_LINES=50                          # distinct configurations in one basket
CART_MAX_LINE_QUANTITY=20
CART_TTL_HOURS=72
# Tip ceiling as a FRACTION of the subtotal: 1 = a 100% tip is the most allowed. The
# tip is the one amount at checkout the server cannot derive from stored rows, so it
# is accepted as a fraction and bounded — a client bug must not turn a small dinner
# into a large charge.
CHECKOUT_MAX_TIP_PERCENT=1
CHECKOUT_DEFAULT_ETA_MINUTES=40            # provisional; the kitchen overwrites it on accept
CHECKOUT_OTP_DIGITS=4                      # the delivery hand-off code
CHECKOUT_OTP_TTL_HOURS=24                  # how long the plaintext stays readable in Redis

# --- routing -----------------------------------------------------------------
# Anything other than `haversine` ABORTS THE BOOT until that provider is written —
# a great-circle distance silently served as a delivery distance is a wrong fare.
ROUTING_PROVIDER=haversine                 # haversine | google | osrm | mapbox | openrouteservice
ROUTING_API_KEY=
ROUTING_BASE_URL=
ROUTING_TIMEOUT_MS=2000

# --- observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=foodora-api
SENTRY_DSN=
METRICS_ENABLED=true
