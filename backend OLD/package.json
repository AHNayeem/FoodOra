{
  "name": "@foodora/backend",
  "version": "0.1.0",
  "private": true,
  "description": "FoodOra API \u2014 NestJS modular monolith (Clean Architecture). Phase E1 foundation.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "NODE_OPTIONS=--max-old-space-size=4096 nest start --watch --preserveWatchOutput",
    "start:debug": "NODE_OPTIONS=--max-old-space-size=4096 nest start --debug --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "db:generate": "cd ../database && bun run generate",
    "db:validate": "cd ../database && bun run validate",
    "db:migrate": "cd ../database && bun run migrate:dev",
    "db:deploy": "cd ../database && bun run migrate:deploy",
    "schema:emit": "bun run scripts/emit-schema.ts",
    "schema:check": "bun run scripts/emit-schema.ts --check",
    "verify:auth": "bun run scripts/verify-auth.ts",
    "verify:core": "bun run scripts/verify-core.ts",
    "verify:cart": "bun run scripts/verify-cart.ts",
    "verify:cart:live": "bun run scripts/verify-cart-live.ts",
    "verify:catalog": "bun run scripts/verify-catalog.ts",
    "verify:checkout": "bun run scripts/verify-checkout.ts",
    "verify:checkout:live": "bun run scripts/verify-checkout-live.ts",
    "seed:reference": "bun run scripts/seed-reference.ts",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "seed:order-demo": "bun run scripts/seed-order-demo.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/helmet": "^13.0.2",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/terminus": "^11.1.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.2",
    "dataloader": "^2.2.3",
    "graphql": "^16.11.0",
    "graphql-query-complexity": "^1.1.0",
    "ioredis": "^5.4.2",
    "jose": "^5",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@types/node": "^20.17.0",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
