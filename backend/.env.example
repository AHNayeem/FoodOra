# FoodOra API — copy to `.env`. Every value below is the default, so a file with
# only DATABASE_URL in it is a working development configuration.
#
#     cp .env.example .env
#
# Nothing here is a secret. `.env` is gitignored; real secrets come from the
# deployment's secret store, and a value committed to a repository is a value
# that has to be rotated.

# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs via pino-pretty. Off in production, where the log is JSON
# that a collector parses.
LOG_PRETTY=true

# Read `x-forwarded-for` for the client address. Turn this on ONLY behind a proxy
# that overwrites the header — on a directly exposed server it lets any caller
# claim any IP address, which defeats the rate limiter.
TRUST_PROXY=false

# Largest request body accepted, in bytes (1 MiB).
BODY_LIMIT_BYTES=1048576

# How long in-flight requests get after SIGTERM before the process exits anyway.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The same database `database/` migrates. There is one schema and one datamodel;
# this backend owns neither.
DATABASE_URL="postgresql://foodora:foodora@localhost:5433/foodora?schema=public"

# The connection that bypasses a connection pooler. The datasource declares
# `directUrl`, so the Prisma CLI refuses to run without it — `prisma validate`,
# `migrate deploy` and `migrate status` all read it, though the running API never
# does. Same as DATABASE_URL unless there is a pooler in front of PostgreSQL: a
# migration through PgBouncer in transaction mode fails on the advisory lock.
DATABASE_DIRECT_URL="postgresql://foodora:foodora@localhost:5433/foodora?schema=public"

# Deadline on the readiness probe's query. Shorter than the load balancer's own
# timeout, or a hung connection reads as "no answer" rather than "not ready".
DATABASE_HEALTH_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated allow-list. `*` is accepted for development and echoes the
# caller's origin; it cannot be combined with credentials by the browser, so a
# wildcard in production would break the session cookie rather than open it up.
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true

# ---------------------------------------------------------------------------
# JWT — the access token. The refresh credential is opaque and lives in
# `refresh_tokens`; see AUTH_SESSION_TTL_DAYS below.
# ---------------------------------------------------------------------------
# REQUIRED in production, minimum 32 characters. Generate with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ISSUER=foodora
JWT_AUDIENCE=foodora-api
JWT_ACCESS_TTL=15m
# Governs `signAccessToken`'s sibling `signRefreshToken` only. Nothing mints a
# refresh JWT — module 2 issues opaque tokens — but the decorator and the guard
# that refuses one as a bearer credential are both still there.
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# Auth & sessions (module 2) — docs/backend/M2-auth-sessions.md
# ---------------------------------------------------------------------------
# Argon2id. OWASP's second profile: m=19456 KiB, t=2, p=1. The parameters live
# inside each hash, so raising them re-hashes on next sign-in rather than
# invalidating anyone's password.
AUTH_ARGON_MEMORY_KIB=19456
AUTH_ARGON_TIME_COST=2
AUTH_ARGON_PARALLELISM=1
# `errors.passwordShort` in all three locale files says "at least 8".
AUTH_PASSWORD_MIN_LENGTH=8

# Consecutive failures before the credential locks, and for how long. This — not
# the in-process rate limiter — is the brute-force defence that survives a
# restart and a second instance.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15

# How long a session lives. The second applies when the client asked to be
# remembered (`sessions.rememberMe`).
AUTH_SESSION_TTL_DAYS=7
AUTH_SESSION_REMEMBER_TTL_DAYS=30

# One-time codes.
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=60
# Password reset token lifetime.
AUTH_RESET_TTL_MINUTES=30

# Return the OTP code and the reset token in the response body.
#
# There is no SMS or email provider in this backend, so without this neither
# flow can be driven end to end at all — the test suite and `npm run auth:flow`
# both set it. **Startup refuses it when NODE_ENV=production.**
AUTH_ECHO_SECRETS=false

# The refresh cookie. Its path is derived from API_PREFIX (`/api/v1/auth`) so it
# always matches where the routes actually are. `Secure` defaults to on in
# production only, because there is no TLS in front of a development server.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Leave unset for a same-origin deployment.
# AUTH_COOKIE_DOMAIN=.foodora.example

# The country a self-registered account is created in. Must be a row in
# `countries` — the currency, locale and timezone are read from it.
AUTH_DEFAULT_COUNTRY=BD

# The tighter per-address ceiling on the six unauthenticated credential routes,
# on top of the global RATE_LIMIT_MAX below.
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Rate limiting — in-process, therefore per instance. A generous backstop, not
# the per-account throttling sign-in will need.
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Base path for every versioned route. `/health` and `/health/ready` are also
# served unprefixed, so a probe URL survives a version bump.
API_PREFIX=/api/v1
