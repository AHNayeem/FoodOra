{
  "name": "@foodora/backend",
  "version": "0.1.0",
  "private": true,
  "description": "FoodOra API — Fastify + JavaScript + Prisma + PostgreSQL. Foundation only; no business modules.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "NODE_ENV=test node --test tests/",
    "seed:reference": "node scripts/seed-reference.js",
    "db:generate": "prisma generate --schema ../database/prisma/schema",
    "db:validate": "prisma validate --schema ../database/prisma/schema",
    "db:status": "prisma migrate status --schema ../database/prisma/schema",
    "check:forbidden": "node scripts/check-forbidden.js",
    "test:watch": "NODE_ENV=test node --test --watch tests/",
    "verify": "npm run db:validate && npm run check:forbidden && npm test"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@foodora/database": "file:../database",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "prisma": "^6.16.2"
  }
}
