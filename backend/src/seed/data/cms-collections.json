      {
        "key": "ctaLabel",
        "label": "Button label",
        "type": "text",
        "localized": true,
        "max": 40
      },
      {
        "key": "ctaHref",
        "label": "Button link",
        "type": "url"
      },
      {
        "key": "icon",
        "label": "Icon",
        "type": "icon",
        "help": "Lucide icon name — see the allow-list in components/directory/dash-icon."
      },
      {
        "key": "tone",
        "label": "Tone",
        "type": "select",
        "options": [
          {
            "value": "primary",
            "label": "Primary"
          },
          {
            "value": "ink",
            "label": "Ink"
          },
          {
            "value": "accent",
            "label": "Accent"
          }
        ]
      }
    ],
    "titleField": "title",
    "creatable": true,
    "orderable": true
  },
